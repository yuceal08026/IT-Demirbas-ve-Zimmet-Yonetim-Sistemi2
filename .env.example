# Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun:  cp .env.example .env
# .env dosyası .gitignore içindedir; asla commit etmeyin. Aşağıdaki örnek değerleri KULLANMAYIN.

# --- PostgreSQL (ZORUNLU) ---
POSTGRES_DB=zimmet
POSTGRES_USER=zimmet
# Güçlü, rastgele bir parola (yalnızca harf, rakam ve - _ . ~ kullanın; URL içinde geçer).
# Üretmek için: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=

# --- API (ZORUNLU) ---
# En az 32 karakter, rastgele. Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# QR kodların içine yazılacak adres (uygulamaya tarayıcıdan erişilen adres)
APP_BASE_URL=http://localhost:8080
# HTTPS arkasında yayınlıyorsanız true yapın (APP_BASE_URL https ise zorunludur)
COOKIE_SECURE=false

# Kurumun saat dilimi ("bugün", tarih filtreleri ve raporlar bu dilime göre)
APP_TIMEZONE=Europe/Istanbul

# Kendi kendine kayıt: yalnızca bu alan adındaki e-postalar kaydolabilir (virgülle birden fazla yazılabilir).
# Kayıtlar yönetici onaylayana kadar giriş yapamaz. Boş bırakılırsa kayıt kapalıdır.
REGISTRATION_EMAIL_DOMAINS=gop.edu.tr

# --- İlk yönetici (İSTEĞE BAĞLI) ---
# Önerilen yöntem: tarayıcıdaki ilk kurulum ekranı (kurulum kodu: docker compose logs api)
# Alternatif olarak aşağıdakileri doldurabilirsiniz; yalnızca hiç aktif yönetici yokken bir kez kullanılır.
# Parola en az 12 karakter, harf ve rakam içermeli. Yönetici oluştuktan sonra parolayı bu dosyadan SİLİN.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=

# Uygulamanın tarayıcıdan açılacağı port
WEB_PORT=8080
