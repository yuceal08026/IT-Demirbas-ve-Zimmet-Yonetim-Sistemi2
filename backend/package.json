{
  "name": "zimmet-api",
  "version": "1.0.0",
  "private": true,
  "description": "IT Demirbaş ve Zimmet Yönetim Sistemi — REST API",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/scripts/migrate.js",
    "seed": "node src/scripts/seed.js",
    "setup": "node src/scripts/migrate.js && node src/scripts/seed.js",
    "create-admin": "node src/scripts/createAdmin.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.3",
    "qrcode": "^1.5.4",
    "zod": "^3.25.0"
  }
}
